# Private operator settings. Run `npm run configure` for a guided setup.
# Import existing application secrets with `npm run configure -- --import-local`.
# Never commit the populated .env or put secrets in NEXT_PUBLIC_* variables.
CLOUDFLARE_ACCOUNT_ID=
# Optional with `npx wrangler login`; otherwise use a scoped deployment API token.
CLOUDFLARE_API_TOKEN=
WORKER_NAME=farcare
# e.g. https://farcare.your-subdomain.workers.dev or https://care.your-domain.com
PUBLIC_ORIGIN=
CUSTOM_DOMAIN=false

# basic = 1 GiB. Upgrade to standard-1 (4 GiB) only if measurements require it.
API_INSTANCE_TYPE=basic
WEB_INSTANCE_TYPE=basic
# always_on: a minute cron keeps/restarts the care service; incurs idle compute.
# on_demand: sleeps after 5 minutes without requests; unsuitable for active care.
CARE_AGENT_MODE=always_on
SESSION_HOURS=24

# console = in-app workflows + simulated provider messages; photon = real delivery.
MESSAGING_CHANNEL=console
PROACTIVE_CHECKINS_ENABLED=false
DATABASE_URL=
INGEST_API_KEY=
PHOTON_API_KEY=
PHOTON_PROJECT_ID=
PHOTON_WEBHOOK_SECRET=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

WORKER_INTERVAL_SECONDS=2
WORKER_BATCH_SIZE=25
WORKER_MAX_DELIVERY_ATTEMPTS=5
WORKER_RETRY_BASE_SECONDS=5
WORKER_RETRY_MAX_SECONDS=300
WORKER_HEARTBEAT_STALE_SECONDS=120

# Enable only after mapping a consenting real person's Tiger subject to their
# actual parent ID from FarCare setup. Do not map real readings to a sample person.
TIGER_SYNC_ENABLED=false
TIGER_SUBJECT_ID=demo
TIGER_PARENT_ID=
TIGER_SYNC_SECONDS=60
TIGER_LOOKBACK_DAYS=35
