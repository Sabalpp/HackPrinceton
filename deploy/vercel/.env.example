# Server-side Vercel Production settings. Never commit a filled copy.
# Import the repository root, not frontend or backend/collector.
# See docs/vercel-deployment.md. Keep database credentials out of NEXT_PUBLIC_*.

# REQUIRED: existing Tiger connection URI, with TLS.
DATABASE_URL=
# REQUIRED: existing ingestion secret, or a newly generated strong secret.
INGEST_API_KEY=
# REQUIRED: exact public HTTPS origin, no path or trailing slash.
CORS_ORIGINS=

# These are also conservative defaults in app.vercel_runtime.
APP_ENV=production
BACKGROUND_TASKS_ENABLED=false
DEMO_MODE=false
SEED_DEMO_DATA=false
SEED_HEALTH_DATA=false
REGISTRATION_ENABLED=false
# Optional sign-in names mapped to existing accounts; see docs/pilot-setup.md.
LOGIN_ALIASES={}
PROACTIVE_CHECKINS_ENABLED=false
MESSAGING_CHANNEL=console
PHOTON_PLATFORM=sms
PHOTON_DELIVERY=off

# Optional after eligible sender, participant opt-in and webhook setup:
# MESSAGING_CHANNEL=photon
# PHOTON_DELIVERY=webhook
# PHOTON_API_KEY=
# PHOTON_PROJECT_ID=
# PHOTON_AGENT_USER_ID=
# PHOTON_WEBHOOK_SECRET=
# GEMINI_API_KEY=

# Leave FARCARE_API_ORIGIN unset: Vercel Services routes /backend itself.
# vercel.json sets NEXT_PUBLIC_API_URL=/backend and disables browser mocks.
