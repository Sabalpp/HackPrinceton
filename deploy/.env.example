# Copy to deploy/.env.production outside git; never paste its values into logs.
# Nothing in this template creates accounts, assigns seats, buys numbers, or deploys.
PUBLIC_ORIGIN=https://farcare.example.com
DATABASE_URL=
INGEST_API_KEY=

PHOTON_API_KEY=
PHOTON_PROJECT_ID=
PHOTON_WEBHOOK_SECRET=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

WORKER_INTERVAL_SECONDS=2
WORKER_BATCH_SIZE=25
WORKER_MAX_DELIVERY_ATTEMPTS=5
WORKER_RETRY_BASE_SECONDS=5
WORKER_RETRY_MAX_SECONDS=300
WORKER_HEARTBEAT_STALE_SECONDS=120
PROACTIVE_CHECKINS_ENABLED=false

# Enable proactive messaging only after consent, routing, trends and live
# two-way delivery have been verified with consenting pilot users.
