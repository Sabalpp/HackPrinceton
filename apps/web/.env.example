NEXT_PUBLIC_API_URL=http://localhost:8000
# true = run fully on dummy data: an in-browser mock backend (lib/mock-server.ts) answers every
# API call and emits live events, so the whole demo works with no server. Use /demo to drive it.
NEXT_PUBLIC_USE_MOCKS=false
# Dashboard viewer token. Dev default is dev-child-token (refused by the API in production).
# NEXT_PUBLIC_VIEWER_TOKEN=
