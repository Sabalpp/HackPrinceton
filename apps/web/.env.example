NEXT_PUBLIC_API_URL=http://localhost:8000
# Keep false for the authenticated three-role app. Development previews use /login's
# explicitly labeled demo accounts with the real API and synthetic fixtures.
# true affects legacy family mock data only; account/parent/helper flows still need the API.
NEXT_PUBLIC_USE_MOCKS=false
# Sign in at /login. Sessions use an HttpOnly cookie and CSRF protection.
# Production uses a same-origin /backend proxy; never publish a family bearer token.
# NEXT_PUBLIC_API_URL=/backend
