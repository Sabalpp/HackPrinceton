{
  "$defs": {
    "DataMode": {
      "enum": [
        "live",
        "simulated"
      ],
      "title": "DataMode",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "One normalized daily health observation (Fitbit via Google Health API, or simulated).",
  "properties": {
    "data_mode": {
      "$ref": "#/$defs/DataMode"
    },
    "observation_id": {
      "examples": [
        "health_001"
      ],
      "pattern": "^[A-Za-z0-9_\\-:.]{1,128}$",
      "title": "Observation Id",
      "type": "string"
    },
    "parent_id": {
      "pattern": "^[A-Za-z0-9_\\-:.]{1,128}$",
      "title": "Parent Id",
      "type": "string"
    },
    "resting_heart_rate": {
      "anyOf": [
        {
          "maximum": 250,
          "minimum": 20,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Resting Heart Rate"
    },
    "sleep_minutes": {
      "anyOf": [
        {
          "maximum": 1440,
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Sleep Minutes"
    },
    "source": {
      "enum": [
        "fitbit",
        "simulated"
      ],
      "title": "Source",
      "type": "string"
    },
    "steps": {
      "anyOf": [
        {
          "maximum": 200000,
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Steps"
    },
    "timestamp": {
      "description": "Start of the observed day (UTC, ISO-8601)",
      "format": "date-time",
      "title": "Timestamp",
      "type": "string"
    }
  },
  "required": [
    "observation_id",
    "parent_id",
    "source",
    "data_mode",
    "timestamp"
  ],
  "title": "HealthObservation",
  "type": "object"
}
