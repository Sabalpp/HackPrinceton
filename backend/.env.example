# FarCare API configuration. Copy to backend/.env (never commit .env).
# Everything is optional for local dev: without Photon/Gemini keys the API uses the
# simulated console channel and the deterministic AI fallback.

APP_ENV=development                 # development | test | production
DATABASE_URL=sqlite:///./farcare.db # production: postgres://... (e.g. Tiger Data / Timescale Cloud)
# Optional READ-ONLY source of live watch data (the Tiger database the collector writes
# air_health.* into). Blank = read watch data from DATABASE_URL. Check with:
#   uv run python scripts/check_tiger.py
TIGER_DATABASE_URL=
CORS_ORIGINS=http://localhost:3000  # comma-separated; add your Vercel URL in production
# GIT_COMMIT=                       # shown on /health; many hosts set RENDER_GIT_COMMIT etc.

# --- Auth (production uses individual cookie sessions; all bearer demo tokens disabled) ---
INGEST_API_KEY=
REGISTRATION_ENABLED=false         # invite-first pilot; operators create the first family account
LOGIN_ALIASES={}                   # server-only JSON map of sign-in names to existing account emails
SESSION_HOURS=24
DEMO_MODE=true
SEED_DEMO_DATA=true
SEED_HEALTH_DATA=true               # false = health data only arrives via POST /api/health/observations
DEMO_CHILD_TOKEN=dev-child-token
DEMO_PARENT_TOKEN=dev-parent-token
DEMO_ADMIN_TOKEN=dev-admin-token
BACKGROUND_TASKS_ENABLED=true      # production MUST use false and run app.worker separately
WORKER_HEARTBEAT_STALE_SECONDS=120

# --- Demo cast: real iMessage handles (E.164 like +15551234567, or Apple-account email). ---
# Each must be distinct. Keep real numbers ONLY in your local/host env.
DEMO_PARENT_HANDLE=+15550100001
DEMO_CHILD_HANDLE=+15550100002
DEMO_RESPONDER_HANDLE=+15550100003
DEMO_RESPONDER2_HANDLE=+15550100004
DEMO_EMERGENCY_NUMBER=              # verified local emergency number for the story's location

# --- Photon 2.0 (Beta): https://photon.codes/docs/beta ---
PHOTON_API_KEY=                     # pho_sk_...
PHOTON_PROJECT_ID=                  # pho_prj_...
PHOTON_WEBHOOK_SECRET=              # whsec_... (webhook destination signing secret)
PHOTON_PLATFORM=imessage            # imessage | sms (SMS requires an eligible registered sender)
PHOTON_AGENT_USER_ID=               # pho_usr_...; REQUIRED for SMS, from Photon Users API/dashboard
PHOTON_DELIVERY=webhook             # webhook | poll (no public URL needed) | off
MESSAGING_CHANNEL=auto              # auto | photon | console (console = simulated even with keys)

# --- Gemini ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# --- Deterministic safety policy (seconds) ---
SAFETY_CHECK_TIMEOUT_SECONDS=60
EMERGENCY_RESPONDER_TIMEOUT_SECONDS=180
REQUEST_REPLY_TIMEOUT_SECONDS=3600
APPROVAL_TIMEOUT_SECONDS=7200
FALL_DEDUPE_WINDOW_SECONDS=600
FAMILY_CHECK_TIMEOUT_SECONDS=300      # "Mom isn't answering" check-in window

# --- Proactive wellness check-ins (max once per parent per local day) ---
PROACTIVE_CHECKINS_ENABLED=true
PROACTIVE_CHECKIN_HOURS=9-19          # parent's local hours [start, end)
PROACTIVE_QUIET_AFTER_CHAT_HOURS=6    # don't interrupt an active conversation
